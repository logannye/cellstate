{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference for arrays, images, tables, or posterior samples.",
      "properties": {
        "dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "assay_id": {
          "minLength": 1,
          "title": "Assay Id",
          "type": "string"
        },
        "cost": {
          "default": 1.0,
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "modality": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "turnaround_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnaround Seconds"
        }
      },
      "required": [
        "assay_id",
        "modality"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "DistributionSupport": {
      "enum": [
        "real",
        "nonnegative",
        "unit_interval",
        "simplex",
        "discrete",
        "mixed"
      ],
      "title": "DistributionSupport",
      "type": "string"
    },
    "DynamicSummary": {
      "additionalProperties": false,
      "properties": {
        "bifurcation_proximity": {
          "$ref": "#/$defs/EvaluatedScalar"
        },
        "death_hazard": {
          "$ref": "#/$defs/EvaluatedScalar"
        },
        "division_hazard": {
          "$ref": "#/$defs/EvaluatedScalar"
        },
        "fate_probabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FateProbability"
          },
          "title": "Fate Probabilities",
          "type": "array"
        },
        "recovery_timescale": {
          "$ref": "#/$defs/EvaluatedScalar"
        },
        "stability": {
          "$ref": "#/$defs/EvaluatedScalar"
        },
        "transition_hazards": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EventHazard"
          },
          "title": "Transition Hazards",
          "type": "array"
        },
        "velocity": {
          "discriminator": {
            "mapping": {
              "parametric": "#/$defs/ParametricDistribution",
              "samples": "#/$defs/SampleDistribution",
              "unavailable": "#/$defs/UnavailableDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ParametricDistribution"
            },
            {
              "$ref": "#/$defs/SampleDistribution"
            },
            {
              "$ref": "#/$defs/UnavailableDistribution"
            }
          ],
          "title": "Velocity"
        }
      },
      "required": [
        "velocity",
        "stability",
        "division_hazard",
        "death_hazard",
        "bifurcation_proximity",
        "recovery_timescale"
      ],
      "title": "DynamicSummary",
      "type": "object"
    },
    "EnvironmentVariableSpec": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "variable": {
          "$ref": "#/$defs/OntologyTerm"
        }
      },
      "required": [
        "variable"
      ],
      "title": "EnvironmentVariableSpec",
      "type": "object"
    },
    "EvaluatedScalar": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/SupportStatus"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "EvaluatedScalar",
      "type": "object"
    },
    "EventHazard": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "rate": {
          "$ref": "#/$defs/EvaluatedScalar"
        }
      },
      "required": [
        "event",
        "rate"
      ],
      "title": "EventHazard",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "observed",
        "inferred_with_support",
        "unidentifiable"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "FactorBelief": {
      "additionalProperties": false,
      "properties": {
        "evidence_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "factor": {
          "$ref": "#/$defs/StateFactor"
        },
        "modality_private_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Modality Private Dimensions",
          "type": "array"
        },
        "posterior": {
          "discriminator": {
            "mapping": {
              "parametric": "#/$defs/ParametricDistribution",
              "samples": "#/$defs/SampleDistribution",
              "unavailable": "#/$defs/UnavailableDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ParametricDistribution"
            },
            {
              "$ref": "#/$defs/SampleDistribution"
            },
            {
              "$ref": "#/$defs/UnavailableDistribution"
            }
          ],
          "title": "Posterior"
        },
        "shared_latent_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Latent Dimensions",
          "type": "array"
        },
        "timescales": {
          "items": {
            "$ref": "#/$defs/Timescale"
          },
          "minItems": 1,
          "title": "Timescales",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "factor",
        "timescales",
        "evidence_status",
        "posterior"
      ],
      "title": "FactorBelief",
      "type": "object"
    },
    "FateProbability": {
      "additionalProperties": false,
      "properties": {
        "fate": {
          "minLength": 1,
          "title": "Fate",
          "type": "string"
        },
        "horizon_seconds": {
          "exclusiveMinimum": 0,
          "title": "Horizon Seconds",
          "type": "number"
        },
        "probability": {
          "$ref": "#/$defs/EvaluatedScalar"
        }
      },
      "required": [
        "fate",
        "horizon_seconds",
        "probability"
      ],
      "title": "FateProbability",
      "type": "object"
    },
    "InterventionSpec": {
      "additionalProperties": false,
      "properties": {
        "dose_units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Units"
        },
        "kind": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OntologyTerm"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/OntologyTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "InterventionSpec",
      "type": "object"
    },
    "JsonValue": {},
    "OntologyTerm": {
      "additionalProperties": false,
      "description": "An extensible biological term, optionally grounded in an ontology.",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        }
      },
      "required": [
        "label"
      ],
      "title": "OntologyTerm",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "functional": {
          "default": true,
          "title": "Functional",
          "type": "boolean"
        },
        "term": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "term",
        "units"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "ParametricDistribution": {
      "additionalProperties": false,
      "properties": {
        "covariance": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Covariance",
          "type": "array"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "kind": {
          "const": "parametric",
          "default": "parametric",
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "items": {
            "type": "number"
          },
          "title": "Mean",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "support": {
          "$ref": "#/$defs/DistributionSupport",
          "default": "real"
        }
      },
      "required": [
        "family",
        "dimensions",
        "mean",
        "covariance"
      ],
      "title": "ParametricDistribution",
      "type": "object"
    },
    "PrecisionRequirement": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "horizon_name": {
          "minLength": 1,
          "title": "Horizon Name",
          "type": "string"
        },
        "maximum_error": {
          "exclusiveMinimum": 0,
          "title": "Maximum Error",
          "type": "number"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "target",
        "horizon_name",
        "metric",
        "maximum_error"
      ],
      "title": "PrecisionRequirement",
      "type": "object"
    },
    "PredictionHorizon": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timescale": {
          "$ref": "#/$defs/Timescale"
        }
      },
      "required": [
        "name",
        "duration_seconds",
        "timescale"
      ],
      "title": "PredictionHorizon",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Minimum audit trail attached to every produced belief or forecast.",
      "properties": {
        "calibration_data_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Data Id"
        },
        "code_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Revision"
        },
        "context_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Context Fingerprint",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "history_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "History Fingerprint",
          "type": "string"
        },
        "history_structure_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "History Structure Fingerprint",
          "type": "string"
        },
        "model_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Model Fingerprint",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "posterior_schema_id": {
          "minLength": 1,
          "title": "Posterior Schema Id",
          "type": "string"
        },
        "query_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Query Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_event_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Event Fingerprints",
          "type": "object"
        },
        "source_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "training_support_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Support Id"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "model_fingerprint",
        "posterior_schema_id",
        "query_fingerprint",
        "history_fingerprint",
        "history_structure_fingerprint",
        "context_fingerprint",
        "seed"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "SampleDistribution": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "kind": {
          "const": "samples",
          "default": "samples",
          "title": "Kind",
          "type": "string"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "samples": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "support": {
          "$ref": "#/$defs/DistributionSupport",
          "default": "real"
        },
        "weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dimensions",
        "samples",
        "sample_count"
      ],
      "title": "SampleDistribution",
      "type": "object"
    },
    "StateFactor": {
      "enum": [
        "stable_identity",
        "slow_memory",
        "regulatory",
        "signaling",
        "metabolic",
        "physical",
        "damage_stress",
        "functional_capacity"
      ],
      "title": "StateFactor",
      "type": "string"
    },
    "StateQuery": {
      "additionalProperties": false,
      "description": "A task-specific definition of predictive and interventional sufficiency.",
      "properties": {
        "available_assays": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssaySpec"
          },
          "title": "Available Assays",
          "type": "array"
        },
        "environment_space": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvironmentVariableSpec"
          },
          "title": "Environment Space",
          "type": "array"
        },
        "intervention_space": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InterventionSpec"
          },
          "title": "Intervention Space",
          "type": "array"
        },
        "precision_requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PrecisionRequirement"
          },
          "title": "Precision Requirements",
          "type": "array"
        },
        "prediction_horizons": {
          "items": {
            "$ref": "#/$defs/PredictionHorizon"
          },
          "minItems": 1,
          "title": "Prediction Horizons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "system_boundary": {
          "$ref": "#/$defs/SystemBoundary"
        },
        "target_outputs": {
          "items": {
            "$ref": "#/$defs/OutputSpec"
          },
          "minItems": 1,
          "title": "Target Outputs",
          "type": "array"
        }
      },
      "required": [
        "system_boundary",
        "prediction_horizons",
        "target_outputs"
      ],
      "title": "StateQuery",
      "type": "object"
    },
    "SupportStatus": {
      "enum": [
        "supported",
        "not_evaluated",
        "unsupported"
      ],
      "title": "SupportStatus",
      "type": "string"
    },
    "SystemBoundary": {
      "enum": [
        "isolated_cell",
        "cell_and_soluble_environment",
        "cell_and_neighbors",
        "clone",
        "population",
        "spatial_tissue_niche"
      ],
      "title": "SystemBoundary",
      "type": "string"
    },
    "TargetPrediction": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "discriminator": {
            "mapping": {
              "parametric": "#/$defs/ParametricDistribution",
              "samples": "#/$defs/SampleDistribution",
              "unavailable": "#/$defs/UnavailableDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ParametricDistribution"
            },
            {
              "$ref": "#/$defs/SampleDistribution"
            },
            {
              "$ref": "#/$defs/UnavailableDistribution"
            }
          ],
          "title": "Distribution"
        },
        "horizon_seconds": {
          "exclusiveMinimum": 0,
          "title": "Horizon Seconds",
          "type": "number"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SupportStatus"
        },
        "target": {
          "$ref": "#/$defs/OutputSpec"
        },
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "target",
        "units",
        "horizon_seconds",
        "status",
        "distribution"
      ],
      "title": "TargetPrediction",
      "type": "object"
    },
    "Timescale": {
      "enum": [
        "fast",
        "intermediate",
        "slow"
      ],
      "title": "Timescale",
      "type": "string"
    },
    "UnavailableDistribution": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "kind": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "message"
      ],
      "title": "UnavailableDistribution",
      "type": "object"
    },
    "UncertaintyBreakdown": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/UncertaintyComponent"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "UncertaintyBreakdown",
      "type": "object"
    },
    "UncertaintyComponent": {
