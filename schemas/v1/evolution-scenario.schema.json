{
  "$defs": {
    "ActualPerturbation": {
      "additionalProperties": false,
      "properties": {
        "efficiency": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Efficiency"
        },
        "evidence_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PerturbationStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "ActualPerturbation",
      "type": "object"
    },
    "EnvironmentEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "const": "environment",
          "default": "environment",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "spatial_region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spatial Region"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        },
        "variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quantity"
              },
              {
                "$ref": "#/$defs/JsonValue"
              }
            ]
          },
          "title": "Variables",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "subject_id",
        "time_seconds",
        "variables"
      ],
      "title": "EnvironmentEvent",
      "type": "object"
    },
    "InterventionEvent": {
      "additionalProperties": false,
      "properties": {
        "actual_perturbation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActualPerturbation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delivery_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Method"
        },
        "dose": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "estimated_efficiency": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Efficiency"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "intervention_type": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "kind": {
          "const": "intervention",
          "default": "intervention",
          "title": "Kind",
          "type": "string"
        },
        "mechanism": {
          "anyOf": [
            {
              "$ref": "#/$defs/OntologyTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reversible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reversible"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/OntologyTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_seconds": {
          "title": "Time Seconds",
          "type": "number"
        }
      },
      "required": [
        "event_id",
        "subject_id",
        "time_seconds",
        "intervention_type"
      ],
      "title": "InterventionEvent",
      "type": "object"
    },
    "JsonValue": {},
    "OntologyTerm": {
      "additionalProperties": false,
      "description": "An extensible biological term, optionally grounded in an ontology.",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        }
      },
      "required": [
        "label"
      ],
      "title": "OntologyTerm",
      "type": "object"
    },
    "PerturbationStatus": {
      "enum": [
        "unknown",
        "inferred",
        "measured",
        "failed"
      ],
      "title": "PerturbationStatus",
      "type": "string"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "units"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "end_time_seconds": {
      "title": "End Time Seconds",
      "type": "number"
    },
    "environments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnvironmentEvent"
      },
      "title": "Environments",
      "type": "array"
    },
    "horizon_name": {
      "minLength": 1,
      "title": "Horizon Name",
      "type": "string"
    },
    "inherit_active_interventions": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inherit Active Interventions"
    },
    "inherit_current_environment": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inherit Current Environment"
    },
    "interventions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InterventionEvent"
      },
      "title": "Interventions",
      "type": "array"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_time_seconds": {
      "title": "Start Time Seconds",
      "type": "number"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "horizon_name",
    "subject_id",
    "start_time_seconds",
    "end_time_seconds"
  ],
  "title": "EvolutionScenario",
  "type": "object"
}
