{
  "$defs": {
    "AcceptanceThresholds": {
      "additionalProperties": false,
      "description": "Numerical scientific-validity gates compiled with a query.",
      "properties": {
        "maximum_calibration_error": {
          "minimum": 0,
          "title": "Maximum Calibration Error",
          "type": "number"
        },
        "maximum_counterfactual_uncertainty": {
          "minimum": 0,
          "title": "Maximum Counterfactual Uncertainty",
          "type": "number"
        },
        "maximum_decision_uncertainty": {
          "minimum": 0,
          "title": "Maximum Decision Uncertainty",
          "type": "number"
        },
        "maximum_history_information_gain": {
          "minimum": 0,
          "title": "Maximum History Information Gain",
          "type": "number"
        },
        "maximum_ood_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Ood Score",
          "type": "number"
        },
        "minimum_calibration_coverage": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minimum Calibration Coverage",
          "type": "number"
        },
        "minimum_identifiability": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minimum Identifiability",
          "type": "number"
        }
      },
      "required": [
        "maximum_ood_score",
        "maximum_history_information_gain",
        "minimum_calibration_coverage",
        "maximum_calibration_error",
        "maximum_counterfactual_uncertainty",
        "maximum_decision_uncertainty",
        "minimum_identifiability"
      ],
      "title": "AcceptanceThresholds",
      "type": "object"
    },
    "AggregationStatistic": {
      "description": "How a target is aggregated over its typed biological subject.",
      "enum": [
        "individual",
        "joint_distribution",
        "distribution",
        "mean",
        "sum",
        "fraction",
        "rate",
        "hazard"
      ],
      "title": "AggregationStatistic",
      "type": "string"
    },
    "AssayPurpose": {
      "description": "Declared use of an assay inside one query.",
      "enum": [
        "target_endpoint",
        "measurement_selection"
      ],
      "title": "AssayPurpose",
      "type": "string"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "assay_id": {
          "minLength": 1,
          "title": "Assay Id",
          "type": "string"
        },
        "collection": {
          "$ref": "#/$defs/ObservationCollection"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "cost_units": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Units"
        },
        "modality": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "protocol_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/AssayPurpose"
          },
          "minItems": 1,
          "title": "Purposes",
          "type": "array"
        },
        "turnaround_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnaround Seconds"
        }
      },
      "required": [
        "assay_id",
        "modality",
        "protocol_reference",
        "collection",
        "purposes"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "AssignmentMechanism": {
      "description": "How exposure was assigned to the experimental unit receiving an action.",
      "enum": [
        "observational",
        "assigned_nonrandom",
        "quasi_experimental",
        "randomized"
      ],
      "title": "AssignmentMechanism",
      "type": "string"
    },
    "CategoricalDomain": {
      "additionalProperties": false,
      "description": "An explicit finite set of permitted categorical values.",
      "properties": {
        "kind": {
          "const": "categorical",
          "default": "categorical",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "CategoricalDomain",
      "type": "object"
    },
    "CensoringDirection": {
      "enum": [
        "below",
        "above",
        "interval"
      ],
      "title": "CensoringDirection",
      "type": "string"
    },
    "CollectionEffect": {
      "enum": [
        "nondestructive",
        "viability_preserving_with_known_effect",
        "partially_destructive_population_sampling",
        "terminal_destructive"
      ],
      "title": "CollectionEffect",
      "type": "string"
    },
    "ConstraintCategory": {
      "enum": [
        "safety",
        "manufacturing",
        "feasibility"
      ],
      "title": "ConstraintCategory",
      "type": "string"
    },
    "ConstraintSpec": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ConstraintCategory"
        },
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength"
        }
      },
      "required": [
        "constraint_id",
        "category",
        "description",
        "strength"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "ConstraintStrength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "EnvironmentTemporalMode": {
      "enum": [
        "fixed",
        "piecewise_constant",
        "time_varying"
      ],
      "title": "EnvironmentTemporalMode",
      "type": "string"
    },
    "EnvironmentVariableSpec": {
      "additionalProperties": false,
      "properties": {
        "allowed_temporal_modes": {
          "items": {
            "$ref": "#/$defs/EnvironmentTemporalMode"
          },
          "minItems": 1,
          "title": "Allowed Temporal Modes",
          "type": "array"
        },
        "default_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Value"
        },
        "domain": {
          "discriminator": {
            "mapping": {
              "categorical": "#/$defs/CategoricalDomain",
              "numeric": "#/$defs/NumericDomain"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumericDomain"
            },
            {
              "$ref": "#/$defs/CategoricalDomain"
            }
          ],
          "title": "Domain"
        },
        "duration_seconds": {
          "$ref": "#/$defs/ScalarRange"
        },
        "missing_history_policy": {
          "$ref": "#/$defs/MissingHistoryPolicy"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "variable": {
          "$ref": "#/$defs/OntologyTerm"
        }
      },
      "required": [
        "variable",
        "domain",
        "duration_seconds",
        "required",
        "allowed_temporal_modes",
        "missing_history_policy"
      ],
      "title": "EnvironmentVariableSpec",
      "type": "object"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "description": "Cutoff-safe observation channels admissible for state estimation.",
      "properties": {
        "allowed_evidence_roles": {
          "items": {
            "$ref": "#/$defs/EvidenceRole"
          },
          "minItems": 1,
          "title": "Allowed Evidence Roles",
          "type": "array"
        },
        "allowed_modalities": {
          "items": {
            "$ref": "#/$defs/OntologyTerm"
          },
          "minItems": 1,
          "title": "Allowed Modalities",
          "type": "array"
        },
        "include_at_cutoff": {
          "title": "Include At Cutoff",
          "type": "boolean"
        },
        "lookback_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lookback Seconds"
        },
        "minimum_observed_measurements": {
          "minimum": 0,
          "title": "Minimum Observed Measurements",
          "type": "integer"
        }
      },
      "required": [
        "include_at_cutoff",
        "allowed_modalities",
        "allowed_evidence_roles",
        "minimum_observed_measurements"
      ],
      "title": "EvidencePolicy",
      "type": "object"
    },
    "EvidenceRole": {
      "enum": [
        "direct",
        "ancestor",
        "descendant",
        "sibling",
        "clone_aggregate",
        "matched_population",
        "general_population",
        "spatial_neighbor",
        "external_reference"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "FutureAssayObservationEndpoint": {
      "additionalProperties": false,
      "properties": {
        "assay_id": {
          "minLength": 1,
          "title": "Assay Id",
          "type": "string"
        },
        "kind": {
          "const": "future_assay_observation",
          "default": "future_assay_observation",
          "title": "Kind",
          "type": "string"
        },
        "protocol_reference": {
          "$ref": "#/$defs/VersionedReference"
        }
      },
      "required": [
        "assay_id",
        "protocol_reference"
      ],
      "title": "FutureAssayObservationEndpoint",
      "type": "object"
    },
    "IdentityBasis": {
      "description": "Observed or explicitly inferred basis for subject identity or linkage.",
      "enum": [
        "observed_identity",
        "direct_tracking",
        "viability_preserving_sampling",
        "observed_parentage",
        "heritable_barcode",
        "phylogeny",
        "probabilistic_lineage",
        "declared_membership",
        "experimental_unit",
        "probabilistic_membership",
        "spatial_region",
        "observed_neighborhood_graph",
        "matched_experimental_design",
        "spatial_proximity",
        "transport_assumption",
        "external_reference"
      ],
      "title": "IdentityBasis",
      "type": "string"
    },
    "IntegerRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "minimum": 1,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "IntegerRange",
      "type": "object"
    },
    "InterventionSpec": {
      "additionalProperties": false,
      "description": "A bounded action family; matching names or units alone never establishes support.",
      "properties": {
        "allowed_assignment_mechanisms": {
          "items": {
            "$ref": "#/$defs/AssignmentMechanism"
          },
          "minItems": 1,
          "title": "Allowed Assignment Mechanisms",
          "type": "array"
        },
        "allowed_reversibility_statuses": {
          "items": {
            "$ref": "#/$defs/ReversibilityStatus"
          },
          "minItems": 1,
          "title": "Allowed Reversibility Statuses",
          "type": "array"
        },
        "assignment_unit_kind": {
          "minLength": 1,
          "title": "Assignment Unit Kind",
          "type": "string"
        },
        "delivery_methods": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Delivery Methods",
          "type": "array"
        },
        "dose_domain": {
          "$ref": "#/$defs/NumericDomain"
        },
        "duration_seconds": {
          "$ref": "#/$defs/ScalarRange"
        },
        "kind": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OntologyTerm"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "randomization_unit_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Unit Kind"
        },
        "realization_evidence": {
          "$ref": "#/$defs/RealizationEvidenceRequirement"
        },
        "require_matched_control": {
          "title": "Require Matched Control",
          "type": "boolean"
        },
        "require_randomization_unit": {
          "title": "Require Randomization Unit",
          "type": "boolean"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduleDomain"
        },
        "spec_id": {
          "minLength": 1,
          "title": "Spec Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/OntologyTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "spec_id",
        "kind",
        "dose_domain",
        "duration_seconds",
        "schedule",
        "delivery_methods",
        "allowed_reversibility_statuses",
        "allowed_assignment_mechanisms",
        "assignment_unit_kind",
        "require_randomization_unit",
        "require_matched_control",
        "realization_evidence"
      ],
      "title": "InterventionSpec",
      "type": "object"
    },
    "LatentQuantityEndpoint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "latent_quantity",
          "default": "latent_quantity",
          "title": "Kind",
          "type": "string"
        },
        "model_reference": {
          "$ref": "#/$defs/VersionedReference"
        }
      },
      "required": [
        "model_reference"
      ],
      "title": "LatentQuantityEndpoint",
      "type": "object"
    },
    "MissingHistoryPolicy": {
      "enum": [
        "reject",
        "represent_as_unknown",
        "use_declared_default"
      ],
      "title": "MissingHistoryPolicy",
      "type": "string"
    },
    "MissingnessStatus": {
      "enum": [
        "observed",
        "not_measured",
        "missing",
        "below_detection",
        "censored",
        "assay_failure"
      ],
      "title": "MissingnessStatus",
      "type": "string"
    },
    "NumericDomain": {
      "additionalProperties": false,
      "description": "A closed, finite numeric domain with mandatory units.",
      "properties": {
        "kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "units"
      ],
      "title": "NumericDomain",
      "type": "object"
    },
    "ObservationCollection": {
      "additionalProperties": false,
      "description": "Biological effect of collecting one observation from its sampled source.",
      "properties": {
        "effect": {
          "$ref": "#/$defs/CollectionEffect"
        },
        "effect_description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Description"
        },
        "sampling_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Fraction"
        }
      },
      "required": [
        "effect"
      ],
      "title": "ObservationCollection",
      "type": "object"
    },
    "OntologyTerm": {
      "additionalProperties": false,
      "description": "An extensible biological term, optionally grounded in an ontology.",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        }
      },
      "required": [
        "label"
      ],
      "title": "OntologyTerm",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/TargetAggregation"
        },
        "censoring": {
          "$ref": "#/$defs/TargetCensoringSemantics"
        },
        "endpoint": {
          "discriminator": {
            "mapping": {
              "future_assay_observation": "#/$defs/FutureAssayObservationEndpoint",
              "latent_quantity": "#/$defs/LatentQuantityEndpoint",
              "versioned_transform": "#/$defs/VersionedTransformEndpoint"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FutureAssayObservationEndpoint"
            },
            {
              "$ref": "#/$defs/LatentQuantityEndpoint"
            },
            {
              "$ref": "#/$defs/VersionedTransformEndpoint"
            }
          ],
          "title": "Endpoint"
        },
        "functional": {
          "title": "Functional",
          "type": "boolean"
        },
        "missingness": {
          "$ref": "#/$defs/TargetMissingnessSemantics"
        },
        "supported_horizon_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Horizon Names",
          "type": "array"
        },
        "term": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "value_schema_reference": {
          "$ref": "#/$defs/VersionedReference"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "term",
        "units",
        "aggregation",
        "endpoint",
        "value_schema_reference",
        "missingness",
        "censoring",
        "supported_horizon_names",
        "weight",
        "functional"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "PerturbationStatus": {
      "enum": [
        "unknown",
        "inferred",
        "measured",
        "failed"
      ],
      "title": "PerturbationStatus",
      "type": "string"
    },
    "PrecisionRequirement": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "horizon_name": {
          "minLength": 1,
          "title": "Horizon Name",
          "type": "string"
        },
        "maximum_error": {
          "exclusiveMinimum": 0,
          "title": "Maximum Error",
          "type": "number"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/OntologyTerm"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "target",
        "horizon_name",
        "metric",
        "maximum_error"
      ],
      "title": "PrecisionRequirement",
      "type": "object"
    },
    "PredictionHorizon": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timescale": {
          "$ref": "#/$defs/Timescale"
        }
      },
      "required": [
        "name",
        "duration_seconds",
        "timescale"
      ],
      "title": "PredictionHorizon",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "units"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "QueryConstraints": {
      "additionalProperties": false,
      "description": "Non-metric constraints whose violation requires abstention.",
      "properties": {
        "allow_transport": {
          "title": "Allow Transport",
          "type": "boolean"
        },
        "allowed_combinations": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Allowed Combinations",
          "type": "array"
        },
        "assay_cost_units": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay Cost Units"
        },
        "forbidden_combinations": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Forbidden Combinations",
          "type": "array"
        },
        "maximum_assay_delay_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Assay Delay Seconds"
        },
        "maximum_intervention_combination_order": {
          "minimum": 1,
          "title": "Maximum Intervention Combination Order",
          "type": "integer"
        },
        "maximum_total_assay_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Total Assay Cost"
        },
        "named_constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConstraintSpec"
          },
          "title": "Named Constraints",
          "type": "array"
        },
        "require_complete_environment_history": {
          "title": "Require Complete Environment History",
          "type": "boolean"
        },
        "require_complete_intervention_history": {
