    "RealizationEvidenceRequirement": {
      "additionalProperties": false,
      "description": "Per-action evidence expected for the latent realized perturbation.\n\nGaps are support/readiness findings, not malformed-event errors. In particular, UNKNOWN may be\nan allowed status even with a nonzero evidence minimum when observations quantify uncertainty\nwithout identifying an efficiency.",
      "properties": {
        "allowed_modalities": {
          "items": {
            "$ref": "#/$defs/OntologyTerm"
          },
          "title": "Allowed Modalities",
          "type": "array"
        },
        "allowed_statuses": {
          "items": {
            "$ref": "#/$defs/PerturbationStatus"
          },
          "minItems": 1,
          "title": "Allowed Statuses",
          "type": "array"
        },
        "minimum_evidence_events": {
          "minimum": 0,
          "title": "Minimum Evidence Events",
          "type": "integer"
        }
      },
      "required": [
        "allowed_statuses",
        "allowed_modalities",
        "minimum_evidence_events"
      ],
      "title": "RealizationEvidenceRequirement",
      "type": "object"
    },
    "ReversibilityStatus": {
      "description": "What is actually known about reversal after an intervention ends.\n\nThis is deliberately separate from a schedule's washout interval.  Removing an\nexposure does not by itself establish that its biological effects are reversible.",
      "enum": [
        "reversible",
        "irreversible",
        "unknown"
      ],
      "title": "ReversibilityStatus",
      "type": "string"
    },
