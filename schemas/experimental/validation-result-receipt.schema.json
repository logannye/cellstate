{
  "$defs": {
    "AccessMode": {
      "description": "Public access may be direct or require registration, but not approval.",
      "enum": [
        "open_download",
        "registration_required"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "AdmissionArtifactKind": {
      "description": "Namespace of an exact byte declaration consumed during admission.",
      "enum": [
        "content_addressed_artifact",
        "dataset_source_artifact"
      ],
      "title": "AdmissionArtifactKind",
      "type": "string"
    },
    "AdmissionArtifactReference": {
      "additionalProperties": false,
      "description": "Normalized exact reference to either a contract artifact or real-data source.",
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/AdmissionArtifactKind"
        },
        "content_addressed_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentAddressedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataset_source_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "artifact_kind"
      ],
      "title": "AdmissionArtifactReference",
      "type": "object"
    },
    "AdmissionVerifierCapability": {
      "description": "Exact observation class a verifier implementation is trusted to attest.",
      "enum": [
        "artifact_byte_resolution",
        "execution_source_selection",
        "loaded_interface_verification",
        "validation_result_semantics"
      ],
      "title": "AdmissionVerifierCapability",
      "type": "string"
    },
    "AdmissionVerifierIdentity": {
      "additionalProperties": false,
      "description": "Exact versioned identity of the code that issued an admission receipt.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/AdmissionVerifierCapability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "code_artifact": {
          "$ref": "#/$defs/ContentAddressedArtifact"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        },
        "verifier_id": {
          "minLength": 1,
          "title": "Verifier Id",
          "type": "string"
        },
        "verifier_version": {
          "minLength": 1,
          "title": "Verifier Version",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "verifier_version",
        "code_artifact",
        "entrypoint",
        "runtime",
        "capabilities"
      ],
      "title": "AdmissionVerifierIdentity",
      "type": "object"
    },
    "ArtifactByteObservation": {
      "additionalProperties": false,
      "description": "Digest and length computed from one concrete byte stream.",
      "properties": {
        "observed_byte_count": {
          "exclusiveMinimum": 0,
          "title": "Observed Byte Count",
          "type": "integer"
        },
        "observed_sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "source_uri",
        "observed_sha256",
        "observed_byte_count"
      ],
      "title": "ArtifactByteObservation",
      "type": "object"
    },
    "ArtifactResolutionReceipt": {
      "additionalProperties": false,
      "description": "Positive receipt proving that observed bytes exactly match one declaration.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/AdmissionArtifactReference"
        },
        "attestation": {
          "$ref": "#/$defs/ReceiptAttestation"
        },
        "evidence_artifacts": {
          "description": "Non-authoritative audit-log references; they never satisfy byte or interface coverage and must not be treated as readiness evidence.",
          "items": {
            "$ref": "#/$defs/ContentAddressedArtifact"
          },
          "minItems": 1,
          "title": "Evidence Artifacts",
          "type": "array"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/ArtifactByteObservation"
        },
        "receipt_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Receipt Fingerprint",
          "type": "string"
        },
        "receipt_id": {
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_kind": {
          "const": "artifact_resolution",
          "default": "artifact_resolution",
          "title": "Receipt Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1-experimental",
          "default": "0.1-experimental",
          "title": "Schema Version",
          "type": "string"
        },
        "verifier": {
          "$ref": "#/$defs/AdmissionVerifierIdentity"
        },
        "verifier_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Verifier Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "artifact",
        "observation",
        "verifier",
        "verifier_fingerprint",
        "issued_at",
        "evidence_artifacts",
        "attestation",
        "receipt_fingerprint"
      ],
      "title": "ArtifactResolutionReceipt",
      "type": "object"
    },
    "BiologicalStagePort": {
      "description": "Original framework stages plus the narrow component's support infrastructure.\n\nThe first eighteen named biological stages are the complete port surface from the original\nproposed ``CellStateModelBundle`` skeleton.  The remaining support ports let a component be\nimplemented and benchmarked without pretending that it is a current-state belief backend.",
      "enum": [
        "query_compiler",
        "reference_prior",
        "observation_models",
        "evidence_transfer_models",
        "intervention_realization_model",
        "transition_model",
        "division_and_inheritance_model",
        "cell_interaction_model",
        "extracellular_transport_model",
        "functional_decoders",
        "mechanistic_constraints",
        "posterior_inference_engine",
        "model_ensemble",
        "uncertainty_calibrator",
        "ood_detector",
        "sufficiency_evaluator",
        "identifiability_analyzer",
        "value_of_information_engine",
        "exact_artifact_resolver",
        "query_scope_validator",
        "train_cal_data_loader",
        "action_context_encoder",
        "population_assay_response_distribution_model",
        "strict_support_ood_gate",
        "artifact_provenance_writer"
      ],
      "title": "BiologicalStagePort",
      "type": "string"
    },
    "ContentAddressedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "byte_count",
        "media_type"
      ],
      "title": "ContentAddressedArtifact",
      "type": "object"
    },
    "CriterionOutcome": {
      "description": "Scientific pass/fail state, kept separate from calculation availability.",
      "enum": [
        "passed",
        "failed",
        "not_evaluated",
        "unsupported"
      ],
      "title": "CriterionOutcome",
      "type": "string"
    },
    "ModelOperation": {
      "description": "Public runtime operation a support envelope may eventually register.",
      "enum": [
        "choose_intervention",
        "estimate_cell_state",
        "evolve_cell_state",
        "recommend_next_measurement"
      ],
      "title": "ModelOperation",
      "type": "string"
    },
    "ReceiptAttestation": {
      "additionalProperties": false,
      "description": "Keyed authentication of a receipt payload by an external verifier trust root.",
      "properties": {
        "algorithm": {
          "const": "hmac-sha256-v1",
          "default": "hmac-sha256-v1",
          "title": "Algorithm",
          "type": "string"
        },
        "attested_payload_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Attested Payload Fingerprint",
          "type": "string"
        },
        "authentication_tag": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Authentication Tag",
          "type": "string"
        },
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "attested_payload_fingerprint",
        "authentication_tag"
      ],
      "title": "ReceiptAttestation",
      "type": "object"
    },
    "SourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "open_download"
        },
        "accession": {
          "minLength": 1,
          "title": "Accession",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "parent_study_accession": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Study Accession"
        },
        "parent_study_release": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Study Release"
        },
        "release": {
          "minLength": 1,
          "title": "Release",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "uri",
        "sha256",
        "media_type",
        "accession",
        "release",
        "byte_count",
        "retrieved_at"
      ],
      "title": "SourceArtifact",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "raw",
        "processed",
        "metadata",
        "documentation"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "ValidationCriterionResult": {
      "additionalProperties": false,
      "description": "One typed criterion outcome with exact result-artifact support.",
      "properties": {
        "criterion": {
          "$ref": "#/$defs/ValidationSemanticCriterion"
        },
        "evidence_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/CriterionOutcome"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "criterion",
        "outcome"
      ],
      "title": "ValidationCriterionResult",
      "type": "object"
    },
    "ValidationEvidenceKind": {
      "description": "Scientific role of a validation result; artifact names never imply this role.",
      "enum": [
        "locked_component_evaluation",
        "model_selection",
        "port_implementation_validation",
        "runtime_operation_validation",
        "support_ood_validation",
        "uncertainty_calibration"
      ],
      "title": "ValidationEvidenceKind",
      "type": "string"
    },
    "ValidationResultManifest": {
      "additionalProperties": false,
      "description": "Canonical result index produced before its own artifact digest is known.",
      "properties": {
        "benchmark_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Benchmark Fingerprint",
          "type": "string"
        },
        "covered_operations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelOperation"
          },
          "title": "Covered Operations",
          "type": "array"
        },
        "covered_ports": {
          "items": {
            "$ref": "#/$defs/BiologicalStagePort"
          },
          "minItems": 1,
          "title": "Covered Ports",
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/ValidationCriterionResult"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "criteria_policy_fingerprint": {
          "default": "e9b99ed0975de3d57127fa4f092a6e09f294079418f6173e83eb8a7af954f8b4",
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Criteria Policy Fingerprint",
          "type": "string"
        },
        "criteria_policy_id": {
          "const": "cellstate.validation-semantic-criteria",
          "default": "cellstate.validation-semantic-criteria",
          "title": "Criteria Policy Id",
          "type": "string"
        },
        "criteria_policy_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Criteria Policy Version",
          "type": "string"
        },
        "evaluation_case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evaluation Case Ids",
          "type": "array"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_kind": {
          "$ref": "#/$defs/ValidationEvidenceKind"
        },
        "evidence_version": {
          "minLength": 1,
          "title": "Evidence Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "implementation_scope_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Implementation Scope Fingerprint",
          "type": "string"
        },
        "model_artifact_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Model Artifact Fingerprint",
          "type": "string"
        },
        "partition_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Partition Ids",
          "type": "array"
        },
        "query_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Query Fingerprint",
          "type": "string"
        },
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "result_manifest_artifact_id": {
          "minLength": 1,
          "title": "Result Manifest Artifact Id",
          "type": "string"
        },
        "result_version": {
          "minLength": 1,
          "title": "Result Version",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1-experimental",
          "default": "0.1-experimental",
          "title": "Schema Version",
          "type": "string"
        },
        "support_envelope_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Support Envelope Fingerprint",
          "type": "string"
        },
        "supporting_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentAddressedArtifact"
          },
          "title": "Supporting Artifacts",
          "type": "array"
        },
        "training_run_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Training Run Fingerprint",
          "type": "string"
        },
        "validation_scope_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Validation Scope Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "result_version",
        "validation_scope_fingerprint",
        "evidence_id",
        "evidence_version",
        "evidence_kind",
        "query_fingerprint",
        "benchmark_fingerprint",
        "support_envelope_fingerprint",
        "training_run_fingerprint",
        "model_artifact_fingerprint",
        "implementation_scope_fingerprint",
        "partition_ids",
        "evaluation_case_ids",
        "covered_ports",
        "result_manifest_artifact_id",
        "criteria",
        "generated_at"
      ],
      "title": "ValidationResultManifest",
      "type": "object"
    },
    "ValidationSemanticCriterion": {
      "description": "Minimum semantic checks whose meaning is fixed by the validation evidence role.",
      "enum": [
        "acceptance_policy_passed",
        "authoritative_case_coverage",
        "calibration_behavior",
        "exact_partition_isolation",
        "evaluation_completeness",
        "implementation_scope_binding",
        "model_selection_freeze",
        "no_untouched_test_access",
        "ood_abstention_behavior",
        "operation_contract_conformance",
        "port_contract_conformance",
        "result_schema_conformance",
        "scientific_support_bounds"
      ],
      "title": "ValidationSemanticCriterion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Authenticated bounded observation from an isolated semantic evaluator.\n\nThe evaluator, not the result manifest, is the authority for criterion outcomes.  It must\nindependently compute them from the exact authenticated result/support bytes and frozen scope\nbefore issuing this receipt.  The receipt is still only an auditable record; admission\nre-authenticates it against an external trust root and the authoritative byte-receipt batch.",
  "properties": {
    "artifact_coverage_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Artifact Coverage Fingerprint",
      "type": "string"
    },
    "artifact_receipts": {
      "items": {
        "$ref": "#/$defs/ArtifactResolutionReceipt"
      },
      "minItems": 1,
      "title": "Artifact Receipts",
      "type": "array"
    },
    "attestation": {
      "$ref": "#/$defs/ReceiptAttestation"
    },
    "bundle_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Bundle Fingerprint",
      "type": "string"
    },
    "evaluation_method": {
      "const": "isolated_semantic_evaluator_v1",
      "default": "isolated_semantic_evaluator_v1",
      "title": "Evaluation Method",
      "type": "string"
    },
    "evaluator": {
      "$ref": "#/$defs/AdmissionVerifierIdentity"
    },
    "evaluator_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Evaluator Fingerprint",
      "type": "string"
    },
    "evidence_binding_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Evidence Binding Fingerprint",
      "type": "string"
    },
    "isolation_evidence_artifact": {
      "$ref": "#/$defs/ContentAddressedArtifact"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "receipt_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Receipt Fingerprint",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_kind": {
      "const": "validation_result_verification",
      "default": "validation_result_verification",
      "title": "Receipt Kind",
      "type": "string"
    },
    "result_manifest": {
      "$ref": "#/$defs/ValidationResultManifest"
    },
    "result_manifest_artifact": {
      "$ref": "#/$defs/ContentAddressedArtifact"
    },
    "schema_version": {
      "const": "0.1-experimental",
      "default": "0.1-experimental",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_scope_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Validation Scope Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "bundle_fingerprint",
    "evidence_binding_fingerprint",
    "validation_scope_fingerprint",
    "result_manifest_artifact",
    "result_manifest",
    "artifact_receipts",
    "artifact_coverage_fingerprint",
    "evaluator",
    "evaluator_fingerprint",
    "isolation_evidence_artifact",
    "issued_at",
    "attestation",
    "receipt_fingerprint"
  ],
  "title": "ValidationResultVerificationReceipt",
  "type": "object"
}
