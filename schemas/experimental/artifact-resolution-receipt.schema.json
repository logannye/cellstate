{
  "$defs": {
    "AccessMode": {
      "description": "Public access may be direct or require registration, but not approval.",
      "enum": [
        "open_download",
        "registration_required"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "AdmissionArtifactKind": {
      "description": "Namespace of an exact byte declaration consumed during admission.",
      "enum": [
        "content_addressed_artifact",
        "dataset_source_artifact"
      ],
      "title": "AdmissionArtifactKind",
      "type": "string"
    },
    "AdmissionArtifactReference": {
      "additionalProperties": false,
      "description": "Normalized exact reference to either a contract artifact or real-data source.",
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/AdmissionArtifactKind"
        },
        "content_addressed_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentAddressedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataset_source_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "artifact_kind"
      ],
      "title": "AdmissionArtifactReference",
      "type": "object"
    },
    "AdmissionVerifierCapability": {
      "description": "Exact observation class a verifier implementation is trusted to attest.",
      "enum": [
        "artifact_byte_resolution",
        "execution_source_selection",
        "loaded_interface_verification",
        "validation_result_semantics"
      ],
      "title": "AdmissionVerifierCapability",
      "type": "string"
    },
    "AdmissionVerifierIdentity": {
      "additionalProperties": false,
      "description": "Exact versioned identity of the code that issued an admission receipt.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/AdmissionVerifierCapability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "code_artifact": {
          "$ref": "#/$defs/ContentAddressedArtifact"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        },
        "verifier_id": {
          "minLength": 1,
          "title": "Verifier Id",
          "type": "string"
        },
        "verifier_version": {
          "minLength": 1,
          "title": "Verifier Version",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "verifier_version",
        "code_artifact",
        "entrypoint",
        "runtime",
        "capabilities"
      ],
      "title": "AdmissionVerifierIdentity",
      "type": "object"
    },
    "ArtifactByteObservation": {
      "additionalProperties": false,
      "description": "Digest and length computed from one concrete byte stream.",
      "properties": {
        "observed_byte_count": {
          "exclusiveMinimum": 0,
          "title": "Observed Byte Count",
          "type": "integer"
        },
        "observed_sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "source_uri",
        "observed_sha256",
        "observed_byte_count"
      ],
      "title": "ArtifactByteObservation",
      "type": "object"
    },
    "ContentAddressedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "sha256",
        "byte_count",
        "media_type"
      ],
      "title": "ContentAddressedArtifact",
      "type": "object"
    },
    "ReceiptAttestation": {
      "additionalProperties": false,
      "description": "Keyed authentication of a receipt payload by an external verifier trust root.",
      "properties": {
        "algorithm": {
          "const": "hmac-sha256-v1",
          "default": "hmac-sha256-v1",
          "title": "Algorithm",
          "type": "string"
        },
        "attested_payload_fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Attested Payload Fingerprint",
          "type": "string"
        },
        "authentication_tag": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Authentication Tag",
          "type": "string"
        },
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "attested_payload_fingerprint",
        "authentication_tag"
      ],
      "title": "ReceiptAttestation",
      "type": "object"
    },
    "SourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "open_download"
        },
        "accession": {
          "minLength": 1,
          "title": "Accession",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "parent_study_accession": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Study Accession"
        },
        "parent_study_release": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Study Release"
        },
        "release": {
          "minLength": 1,
          "title": "Release",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "uri",
        "sha256",
        "media_type",
        "accession",
        "release",
        "byte_count",
        "retrieved_at"
      ],
      "title": "SourceArtifact",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "raw",
        "processed",
        "metadata",
        "documentation"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Positive receipt proving that observed bytes exactly match one declaration.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/AdmissionArtifactReference"
    },
    "attestation": {
      "$ref": "#/$defs/ReceiptAttestation"
    },
    "evidence_artifacts": {
      "description": "Non-authoritative audit-log references; they never satisfy byte or interface coverage and must not be treated as readiness evidence.",
      "items": {
        "$ref": "#/$defs/ContentAddressedArtifact"
      },
      "minItems": 1,
      "title": "Evidence Artifacts",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/ArtifactByteObservation"
    },
    "receipt_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Receipt Fingerprint",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_kind": {
      "const": "artifact_resolution",
      "default": "artifact_resolution",
      "title": "Receipt Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1-experimental",
      "default": "0.1-experimental",
      "title": "Schema Version",
      "type": "string"
    },
    "verifier": {
      "$ref": "#/$defs/AdmissionVerifierIdentity"
    },
    "verifier_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Verifier Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "artifact",
    "observation",
    "verifier",
    "verifier_fingerprint",
    "issued_at",
    "evidence_artifacts",
    "attestation",
    "receipt_fingerprint"
  ],
  "title": "ArtifactResolutionReceipt",
  "type": "object"
}
