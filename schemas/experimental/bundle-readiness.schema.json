{
  "$defs": {
    "BundleAdmissionBlockerCode": {
      "description": "Machine-readable v0.1 gates that declarations cannot satisfy.",
      "enum": [
        "artifact_bytes_unresolved",
        "implementation_interfaces_unverified",
        "query_derived_operation_prerequisites_unverified",
        "validation_results_unverified"
      ],
      "title": "BundleAdmissionBlockerCode",
      "type": "string"
    },
    "ComponentLifecycleStage": {
      "description": "Derived component progress; stages are never declared on a source bundle.",
      "enum": [
        "scaffold",
        "trained_candidate",
        "calibrated_candidate",
        "model_selected_frozen",
        "component_evaluated",
        "component_gates_passed"
      ],
      "title": "ComponentLifecycleStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Derived readiness result; no field is accepted on the source bundle contract.",
  "properties": {
    "admission_blocker_codes": {
      "items": {
        "$ref": "#/$defs/BundleAdmissionBlockerCode"
      },
      "title": "Admission Blocker Codes",
      "type": "array"
    },
    "artifact_bytes_resolved": {
