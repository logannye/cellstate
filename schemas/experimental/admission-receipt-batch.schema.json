      "title": "Required Interfaces",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1-experimental",
      "default": "0.1-experimental",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "bundle_fingerprint",
    "implementation_scope_fingerprint",
    "execution_source_selection",
    "required_artifacts",
    "artifact_receipts",
    "artifact_coverage_fingerprint",
    "interface_coverage_fingerprint",
    "issued_at",
    "evidence_artifacts",
    "report_fingerprint"
