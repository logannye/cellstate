    },
    "interface_coverage_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Interface Coverage Fingerprint",
      "type": "string"
    },
    "interface_receipts": {
      "default": [],
      "items": {
