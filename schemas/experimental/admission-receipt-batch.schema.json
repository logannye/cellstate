      "title": "Issued At",
      "type": "string"
    },
    "report_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Report Fingerprint",
      "type": "string"
    },
    "report_kind": {
      "const": "complete_admission_receipt_batch",
      "default": "complete_admission_receipt_batch",
      "title": "Report Kind",
      "type": "string"
    },
    "required_artifacts": {
      "items": {
        "$ref": "#/$defs/AdmissionArtifactReference"
