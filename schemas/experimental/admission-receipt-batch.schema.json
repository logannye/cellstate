    },
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "bundle_fingerprint": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Bundle Fingerprint",
      "type": "string"
    },
    "evidence_artifacts": {
      "description": "Non-authoritative batch audit-log references; only the closed required/receipt sets above contribute admission coverage.",
      "items": {
