        "artifact_schema": {
          "const": "cellstate-contained-execution-observation",
          "default": "cellstate-contained-execution-observation",
          "title": "Artifact Schema",
          "type": "string"
        },
        "artifact_schema_version": {
          "const": "1.2.0",
          "default": "1.2.0",
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "canonical_publication_performed": {
          "const": false,
          "default": false,
          "title": "Canonical Publication Performed",
          "type": "boolean"
        },
        "container_removed": {
          "const": true,
          "default": true,
          "title": "Container Removed",
          "type": "boolean"
        },
        "container_user_mode": {
          "const": "host-effective-uid-gid",
          "title": "Container User Mode",
          "type": "string"
        },
        "execution_id": {
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "observed_container_gid": {
          "minimum": 0,
          "title": "Observed Container Gid",
          "type": "integer"
        },
        "observed_container_uid": {
          "minimum": 0,
          "title": "Observed Container Uid",
          "type": "integer"
        },
        "oom_killed": {
          "title": "Oom Killed",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "success",
            "timeout",
            "oom_killed",
            "worker_failure"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "parent_wall_clock_elapsed_seconds": {
          "minimum": 0.0,
          "title": "Parent Wall Clock Elapsed Seconds",
          "type": "number"
        },
        "policy_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "process_tree_cleaned": {
          "const": true,
          "default": true,
          "title": "Process Tree Cleaned",
          "type": "boolean"
        },
        "runtime_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Runtime Image Digest",
          "type": "string"
        },
        "snapshot_volume_removed": {
          "const": true,
          "default": true,
          "title": "Snapshot Volume Removed",
          "type": "boolean"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "worker_watchdog_timed_out": {
          "default": false,
          "title": "Worker Watchdog Timed Out",
          "type": "boolean"
        }
