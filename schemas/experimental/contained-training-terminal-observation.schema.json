{
  "$defs": {
    "CanonicalPublicationTreeIdentity": {
      "additionalProperties": false,
      "description": "Content identity for a no-follow snapshot of the canonical publication tree.",
      "properties": {
        "artifact_schema": {
          "const": "cellstate-canonical-publication-tree-identity",
          "default": "cellstate-canonical-publication-tree-identity",
          "title": "Artifact Schema",
          "type": "string"
        },
        "artifact_schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "directory_count": {
          "minimum": 0,
          "title": "Directory Count",
          "type": "integer"
        },
        "file_count": {
          "minimum": 0,
          "title": "File Count",
          "type": "integer"
        },
        "state": {
          "enum": [
            "absent",
            "present"
          ],
          "title": "State",
          "type": "string"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tree Sha256",
          "type": "string"
        }
      },
      "required": [
        "state",
        "tree_sha256",
        "directory_count",
        "file_count",
        "byte_count"
      ],
      "title": "CanonicalPublicationTreeIdentity",
      "type": "object"
    },
    "ContainedExecutionObservation": {
      "additionalProperties": false,
      "description": "Sanitized parent observation; it grants no publication or lifecycle authority.",
